@page "/calculadora"

@inject CalculadoraService CalcService
@rendermode InteractiveServer

<h3>Calculadora</h3>


<select @bind="selectedWeaponName">
    @foreach (var weapon in weapons)
    {
        <option value="@weapon.Name">
            @weapon.Name
        </option>
    }
</select>

@*
<label>
    <input type="checkbox" @bind="settings.Headshot" />
    Headshot
</label>

<label>
    <input type="checkbox" @bind="settings.Stealth" />
    Stealth
</label>

<input type="number" @bind="settings.Distance" />
*@

<h4>Crit</h4>
<select @bind="settings.CritMode">
    @foreach (var mode in Enum.GetValues<EvaluationMode>())
    {
        <option value="@mode">@mode</option>
    }
</select>

<h4>Status</h4>
<select @bind="settings.StatusMode">
    @foreach (var mode in Enum.GetValues<EvaluationMode>())
    {
        <option value="@mode">@mode</option>
    }
</select>

<h4>Multishot</h4>
<select @bind="settings.MultiMode">
    @foreach (var mode in Enum.GetValues<EvaluationMode>())
    {
        <option value="@mode">@mode</option>
    }
</select>

<button @onclick="Calcular">
    Calcular
</button>


@if (result != null)
{
    <p>
        Damage Per Click: @result.TotalDamage
    </p>

    int projectile = 1;

    @foreach (var shot in result.Projectiles)
    {
        <h4>Projectile @projectile</h4>

        <p>Damage: @shot.Damage</p>
        <p>Crit Multiplier: @shot.CritMultiplier</p>

        @if (shot.StatusApplied.Count > 0)
        {
            <p>Status:</p>

            <ul>
                @foreach (var status in shot.StatusApplied)
                {
                    <li>@status.Key.Damage: @status.Value</li>
                }
            </ul>
        }
        else
        {
            <p>No status applied.</p>
        }

        projectile++;
    }
}

@code {

    private List<Weapon> weapons = Weapons.All;
    private DamageResult? result;
    private CalculadoraSettings settings = new();

    private string selectedWeaponName;
    private Weapon? SelectedWeapon => weapons.FirstOrDefault(x => x.Name == selectedWeaponName);

    protected override void OnInitialized()
    {
        selectedWeaponName = weapons.First().Name;
    }

    private void Calcular()
    {
        result = CalcService.Damage_Per_Click(SelectedWeapon, settings);
    }
}